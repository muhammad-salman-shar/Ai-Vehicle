<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Vehicle" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="backgroundColor">@color/background</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/surface</item>
        <item name="colorSecondaryVariant">@color/surface</item>
        <item name="colorOnSecondary">@color/white</item>
    </style>

    <style name="KillSwitchButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/kill_switch</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="AccentButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">8dp</item>
    </style>
</resources>
